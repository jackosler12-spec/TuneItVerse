{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TuneItVerse",
  "version": "3.18.0",
  "identifier": "com.jrtuners.tuneitverse",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "TuneItVerse ECU Tuning Platform v3.18.0",
        "width": 1400,
        "height": 900
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
