{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TuneItVerse",
  "version": "0.2.0",
  "identifier": "com.jrtuners.tuneitverse",
  "build": {
    "frontendDist": "../src",
    "beforeBuildCommand": "",
    "beforeDevCommand": "",
    "features": ["custom-protocol"]
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "TuneItVerse - Professional ECU Tuning Platform",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 720,
        "resizable": true,
        "fullscreen": false,
        "transparent": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' http://localhost:* ws://localhost:*;",
      "dangerousDisableAssetCspModification": false
    },
    "trayIcon": {
      "icon": "icons/icon.ico",
      "tooltip": "TuneItVerse - ECU Tuning",
      "menuOnLeftClick": true
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English"],
        "compression": "lzma",
        "displayLanguageSelector": false,
        "startMenuFolder": "JRTuners",
        "headerImage": null,
        "sidebarImage": null,
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "webviewInstallMode": "embedBootstrapper"
      }
    }
  },
  "plugins": {}
}