  <ADXVALUE id="LOAD" idhash="0xAA726CF9" title="Engine Load">
    <flags>0x0000000C</flags>
    <parentcmdidhash>0x5AA24DB8</parentcmdidhash>
    <units>%</units>
    <packetoffset>0x00</packetoffset>
    <range low="0.000000" high="100.000000" />
