{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TuneItVerse",
  "version": "0.1.0",
  "identifier": "com.jrtuners.tuneitverse",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "TuneItVerse",
        "width": 1440,
        "height": 900,
        "resizable": true,
        "fullscreen": false,
        "transparent": false,
        "minWidth": 1100,
        "minHeight": 720
      },

    ],
    "security": {
        "csp": null
      }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "both",
        "languages": ["English"],
        "template": null
      }
    }
  }
}